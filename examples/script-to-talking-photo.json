        "voiceId": "={{ $json.voice_id }}",
        "tier": "free",
        "wait": true,
        "maxWaitMinutes": 20,
        "additionalFields": {}
      },
      "type": "n8n-nodes-storkai.storkAi",
      "typeVersion": 1,
      "position": [440, 0],
      "id": "5a1f0c1e-0003-4a6b-9c11-000000000003",
      "name": "Make the talking photo"
    }
  ],
  "connections": {
