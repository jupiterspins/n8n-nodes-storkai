{
  "name": "Script to talking-photo video (Stork AI)",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "5a1f0c1e-0001-4a6b-9c11-000000000001",
      "name": "When clicking 'Execute workflow'"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "5a1f0c1e-00a1-4a6b-9c11-0000000000a1", "name": "script", "value": "Hi! This video was made from one photo and one line of text, inside an n8n workflow.", "type": "string" },
            { "id": "5a1f0c1e-00a2-4a6b-9c11-0000000000a2", "name": "photo_url", "value": "https://www.stork.ai/samples/talking-photo/portrait.jpg", "type": "string" },
            { "id": "5a1f0c1e-00a3-4a6b-9c11-0000000000a3", "name": "voice_id", "value": "en-leo", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "id": "5a1f0c1e-0002-4a6b-9c11-000000000002",
      "name": "Script, photo and voice"
    },
    {
      "parameters": {
        "resource": "talkingPhoto",
        "operation": "create",
        "imageUrl": "={{ $json.photo_url }}",
